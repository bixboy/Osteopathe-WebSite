---
import { ChevronDown } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SessionSteps from '../components/SessionSteps.astro';
import { seanceDuration } from '../data/seance';
import { getFaq } from '../lib/content';
import { getPracticalFaq } from '../lib/faq-pratique';
import { faqSchema } from '../lib/schema';

const faq = [
  ...(await getFaq()).map(({ data, body }) => ({ question: data.question, answer: body?.trim() ?? '' })),
  ...getPracticalFaq(),
];
const schema = faqSchema(faq);
---

<BaseLayout
  title="L’ostéopathie"
  description="Qu’est-ce que l’ostéopathie, comment se déroule une séance et quand consulter un ostéopathe à Bayeux."
  schema={schema}
>
  <PageHeader
    eyebrow="L’ostéopathie"
    title="Une approche globale du corps"
    lead="L’ostéopathie est une thérapie manuelle qui s’intéresse au corps dans son ensemble, pour l’aider à retrouver son équilibre."
  />

  <section class="section">
    <div class="container prose">
      <!-- TODO(contenu): texte de présentation de l'ostéopathie à valider avec la cliente -->
      <p>
        L’ostéopathe recherche, par la palpation, les zones du corps qui ont perdu de leur
        mobilité. Par des techniques manuelles adaptées, il accompagne le corps vers un meilleur
        fonctionnement.
      </p>
      <p>
        L’ostéopathie s’adresse aux troubles fonctionnels. Elle ne remplace pas un suivi
        médical, mais peut le compléter.
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="seance-titre">
    <div class="container">
      <SectionHeader
        id="seance-titre"
        eyebrow="Votre consultation"
        title="Comment se déroule une séance ?"
        lead={`Une consultation dure environ ${seanceDuration}.`}
      />
      <SessionSteps />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-titre">
    <div class="container faq">
      <SectionHeader id="faq-titre" eyebrow="FAQ" title="Questions fréquentes" />
      <div class="faq__list">
        {
          faq.map(({ question, answer }) => (
            <details class="faq__item">
              <summary>
                {question}
                <ChevronDown size={20} aria-hidden="true" />
              </summary>
              <p>{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .faq {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform var(--transition);
  }

  .faq__item[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .faq__item p {
    padding: 0 var(--space-4) var(--space-4);
    color: var(--color-text-muted);
  }
</style>
