---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import PracticalInfo from '../components/PracticalInfo.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SessionSteps from '../components/SessionSteps.astro';
import SoinGrid from '../components/SoinGrid.astro';
import SoinIcon from '../components/SoinIcon.astro';
import TrustBar from '../components/TrustBar.astro';
import { site } from '../data/site';
import { seanceDuration } from '../data/seance';
import GoogleReviews from '../components/GoogleReviews.astro';
import { getSoins } from '../lib/content';
import portrait from '../assets/images/portrait-fanny-gerszkourez.webp';

const soins = await getSoins();
const firstName = site.name.split(' ')[0];
---

<BaseLayout alternate="/en">
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow enter">{site.profession} · {site.address.city}</span>
        <h1 class="enter" style="--delay: 1">Prendre soin de votre corps, <em>à chaque étape</em> de la vie</h1>
        <p class="lead enter" style="--delay: 2">
          Nourrissons, femmes enceintes, sportifs et adultes : une ostéopathie douce, à l’écoute
          et adaptée à chacun, à {site.address.city}.
        </p>
        <div class="hero__actions enter" style="--delay: 3">
          <BookingButton />
          <Button href="/osteopathie" variant="secondary">L’ostéopathie</Button>
        </div>
        <ul class="hero__tags enter" style="--delay: 4" aria-label="Publics accompagnés">
          {soins.map(({ data }) => (
            <li><SoinIcon name={data.icon} size={16} />{data.shortTitle}</li>
          ))}
        </ul>
      </div>

      <div class="hero__visual enter" style="--delay: 2">
        <!-- TODO(phase 3): remplacer la forme par le portrait de la cliente (<Image />) -->
        <div class="hero__shape" aria-hidden="true"></div>
        <span class="hero__dot hero__dot--1" aria-hidden="true"></span>
        <span class="hero__dot hero__dot--2" aria-hidden="true"></span>
        <div class="hero__card">
          <p class="hero__card-title">Le cabinet</p>
          <PracticalInfo compact />
        </div>
      </div>
    </div>
  </section>

  <TrustBar />

  <section class="section" aria-labelledby="soins-titre">
    <div class="container">
      <SectionHeader
        id="soins-titre"
        eyebrow="Pour qui ?"
        title="Une ostéopathie adaptée à chaque âge"
        lead="Chaque séance tient compte de votre histoire, de votre rythme et de vos besoins."
      />
      <SoinGrid soins={soins} />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="seance-titre">
    <div class="container">
      <SectionHeader
        id="seance-titre"
        eyebrow="Votre consultation"
        title="Comment se déroule une séance ?"
        lead={`Une consultation dure environ ${seanceDuration}, en trois temps.`}
      />
      <SessionSteps />
    </div>
  </section>

  <GoogleReviews />

  <section class="section" aria-labelledby="apropos-titre">
    <div class="container about">
      <Image
        class="about__portrait reveal"
        src={portrait}
        alt={`Portrait de ${site.name}`}
        widths={[320, portrait.width]}
        sizes="(min-width: 52rem) 24rem, 100vw"
      />
      <div class="about__content reveal">
        <SectionHeader id="apropos-titre" eyebrow="À propos" title={`Bonjour, je suis ${firstName}`} />
        <!-- TODO(cliente): texte de présentation dans ses mots -->
        <p>
          Diplômée de l’Institut Supérieur d’Ostéopathie de Paris en 2015, je suis installée à
          Bayeux depuis 2017. Formée en périnatalité et en approche tissulaire, j’ai également été
          assistante en milieu hospitalier : urgences traumatiques, chirurgie orthopédique et maternité.
        </p>
        <Button href="/a-propos" variant="secondary">Mon parcours <ArrowRight size={18} aria-hidden="true" /></Button>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: var(--space-5) var(--space-5);
    overflow: hidden;
  }

  /* Halos de couleur flous en arrière-plan */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: var(--radius-pill);
    filter: blur(60px);
    opacity: 0.55;
  }

  .hero::before {
    width: 28rem;
    height: 28rem;
    left: -10rem;
    top: -8rem;
    background: var(--color-sand);
  }

  .hero::after {
    width: 22rem;
    height: 22rem;
    right: -6rem;
    bottom: -8rem;
    background: var(--color-primary-soft);
  }

  /* minmax(0, …) : un contenu qui ne revient pas à la ligne (étiquettes) ne peut pas élargir la colonne */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  h1 em {
    color: var(--color-primary);
    font-style: italic;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__tags li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .hero__visual {
    position: relative;
    padding-bottom: var(--space-6);
  }

  .hero__shape {
    position: relative;
    aspect-ratio: 1;
    max-width: min(30rem, 80%);
    margin-inline: auto;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    background:
      radial-gradient(circle at 30% 25%, var(--color-sand), transparent 60%),
      linear-gradient(145deg, var(--color-primary-soft), var(--color-primary));
  }

  /* Petites pastilles décoratives qui flottent autour de la forme */
  .hero__dot {
    position: absolute;
    border-radius: var(--radius-pill);
  }

  .hero__dot--1 {
    width: 1.5rem;
    height: 1.5rem;
    top: 6%;
    right: 12%;
    background: var(--color-accent);
  }

  .hero__dot--2 {
    width: 0.875rem;
    height: 0.875rem;
    top: 42%;
    left: 6%;
    border: 2px solid var(--color-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__shape {
      animation: morph 16s ease-in-out infinite;
    }

    .hero__card {
      animation: float 7s ease-in-out infinite;
    }

    .hero__dot--1 {
      animation: float 5s ease-in-out infinite;
    }

    .hero__dot--2 {
      animation: float 6s ease-in-out -2s infinite;
    }
  }

  @keyframes morph {
    33% {
      border-radius: 45% 55% 40% 60% / 55% 42% 58% 45%;
    }

    66% {
      border-radius: 52% 48% 60% 40% / 42% 58% 46% 54%;
    }
  }

  @keyframes float {
    50% {
      translate: 0 -0.75rem;
    }
  }

  .hero__card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-width: 22rem;
    margin-inline: auto;
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }

  @media (min-width: 60rem) {
    .hero__card {
      right: auto;
      left: -2rem;
    }
  }

  .hero__card-title {
    margin-bottom: var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  /* ---------- Hero sur mobile et tablette ---------- */
  .hero__actions > :global(a) {
    flex: 1 1 14rem;
  }

  @media (max-width: 59.99rem) {
    /* La forme décorative serait masquée par la carte : on garde la carte seule */
    .hero__shape,
    .hero__dot {
      display: none;
    }

    .hero__visual {
      padding-bottom: 0;
    }

    .hero__card {
      position: static;
      max-width: none;
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-sm);
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-block: var(--space-4) var(--space-5);
    }

    .hero__inner {
      gap: var(--space-5);
    }

    /* Étiquettes sur une seule ligne qu'on fait glisser, fondu sur le bord droit */
    .hero__tags {
      flex-wrap: nowrap;
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, black 85%, transparent);
    }

    .hero__tags::-webkit-scrollbar {
      display: none;
    }

    .hero__tags li {
      flex-shrink: 0;
    }
  }

  /* ---------- À propos ---------- */
  .about {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .about {
      grid-template-columns: 1fr 1.3fr;
    }
  }

  .about :global(.about__portrait) {
    width: 100%;
    max-width: 24rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg) var(--radius-lg) 12rem 12rem;
  }

  .about__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .about__content :global(.section-header) {
    margin-bottom: 0;
  }
</style>
