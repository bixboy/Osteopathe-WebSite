---
import type { HTMLAttributes } from 'astro/types';

/** Rend un <a> si `href` est fourni, sinon un <button type="button">. */
interface Props extends HTMLAttributes<'a'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'light';
  size?: 'md' | 'sm';
  /** Ouvre dans un nouvel onglet et l'annonce aux lecteurs d'écran. */
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const attrs: Record<string, unknown> = {
  ...rest,
  ...(href ? { href } : { type: 'button' }),
  ...(external && { target: '_blank', rel: 'noopener' }),
};
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...attrs}>
  <slot />
  {external && <span class="visually-hidden">(nouvel onglet)</span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.2;
    font-family: inherit;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  /* Soulèvement au survol (souris uniquement : au toucher il resterait « collé ») */
  @media (hover: hover) {
    .btn:hover {
      transform: translateY(-1px);
    }
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn--md {
    min-height: 3.25rem;
    padding-inline: var(--space-4);
    font-size: var(--text-base);
  }

  .btn--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-sm);
  }

  .btn--primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
    box-shadow: var(--shadow);
  }

  .btn--secondary {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn--secondary:hover {
    background: var(--color-primary-soft);
  }

  .btn--light {
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .btn--light:hover {
    background: var(--color-bg);
    color: var(--color-primary-hover);
  }
</style>
