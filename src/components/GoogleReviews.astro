---
import { MessageSquarePlus } from '@lucide/astro';
import Button from './Button.astro';
import Carousel from './Carousel.astro';
import SectionHeader from './SectionHeader.astro';
import StarRating from './StarRating.astro';
import { site } from '../data/site';
import { getAvis } from '../lib/content';
import { formatMonth, formatRating, initials } from '../lib/format';

/**
 * Avis Google recopiés à la main : note globale dans `site.google`, avis dans
 * src/content/avis/. Aucun appel à Google, ni au build ni dans le navigateur.
 */
const { placeId, rating, ratingCount, ratingCheckedAt } = site.google;
const avis = await getAvis();
const links = {
  all: `https://search.google.com/local/reviews?placeid=${placeId}`,
  write: `https://search.google.com/local/writereview?placeid=${placeId}`,
};
---

<section class="section section--sand" aria-labelledby="avis-titre">
  <div class="container">
    <div class="head">
      <SectionHeader
        id="avis-titre"
        eyebrow="Avis Google"
        title="Ce qu’en disent les patients"
        lead={avis.length ? undefined : 'Retrouvez les avis des patients sur la fiche Google du cabinet.'}
      />
      <div class="summary">
        <span class="summary__score">{formatRating(rating)}</span>
        <div>
          <StarRating rating={rating} size={20} />
          <p>{ratingCount} avis sur Google</p>
        </div>
      </div>
    </div>

    {
      avis.length > 0 && (
        <Carousel class="reviews reveal-children" min="18rem" max="calc((100% - 2 * var(--space-4)) / 3)">
          {avis.map(({ data, body }) => (
            <li class="review">
              <div class="review__head">
                <span class="review__avatar" aria-hidden="true">{initials(data.author).slice(0, 2)}</span>
                <div>
                  <span class="review__author">{data.author}</span>
                  <span class="review__time">
                    Visite en <time datetime={data.visited}>{formatMonth(data.visited)}</time>
                  </span>
                </div>
              </div>
              <StarRating rating={data.rating} size={16} />
              <p class="review__text">{body?.trim()}</p>
            </li>
          ))}
        </Carousel>
      )
    }

    <div class="actions">
      <Button href={links.all} variant="secondary" size="sm" external>
        Voir tous les avis
      </Button>
      <Button href={links.write} variant="secondary" size="sm" external>
        <MessageSquarePlus size={18} aria-hidden="true" /> Laisser un avis
      </Button>
    </div>

    {
      avis.length > 0 && (
        // Mention exigée pour une sélection d'avis (art. L111-7-2 et D111-17 du Code de la consommation)
        <p class="disclaimer">
          Sélection d’avis publiés sur Google Maps, choisie par le cabinet,
          relevée en {formatMonth(ratingCheckedAt)} et reproduite sans modification (noms abrégés), de la visite
          la plus récente à la plus ancienne. Ces avis ne font l’objet d’aucune vérification.
          L’ensemble des avis est consultable sur la fiche Google du cabinet.
        </p>
      )
    }
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .head :global(.section-header) {
    margin-bottom: 0;
  }

  .summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .summary__score {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .summary p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Mise en page de la liste : composant Carousel */
  .head + :global(.reviews) {
    margin-bottom: var(--space-5);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .review__head > div {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .review__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .review__author {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .review__time {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .review__text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .disclaimer {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
</style>
