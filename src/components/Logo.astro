---
import { site } from '../data/site';
import { initials } from '../lib/format';
---

<a class="logo" href="/">
  <!-- TODO(phase 2): remplacer le monogramme par le logo de la cliente s'il existe -->
  <span class="logo__mark" aria-hidden="true">{initials(site.name)}</span>
  <span class="logo__text">
    <strong>{site.name}</strong>
    <span>{site.profession} · {site.address.city}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .logo:hover {
    color: inherit;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: italic;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .logo__text strong {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
  }

  .logo__text span {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    opacity: 0.75;
  }
</style>
