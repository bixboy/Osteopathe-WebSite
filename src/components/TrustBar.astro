---
import { CalendarCheck, Clock, Languages, Star } from '@lucide/astro';
import { site } from '../data/site';
import { formatDays, formatRating } from '../lib/format';

/** Points forts du cabinet, tous issus de src/data/site.ts (aucun texte inventé ici). */
const { google, openingHours, languages } = site;
const firstDay = openingHours[0].days[0];
const lastDay = openingHours.at(-1)!.days.at(-1)!;
const items = [
  { icon: Star, title: `${formatRating(google.rating)} / 5 sur Google`, text: `${google.ratingCount} avis de patients` },
  { icon: Clock, title: formatDays([firstDay, lastDay]), text: 'Horaires dans Infos pratiques' },
  { icon: Languages, title: languages.join(' · '), text: 'Langues de consultation' },
  { icon: CalendarCheck, title: 'Rendez-vous en ligne', text: '24 h/24 sur Doctolib' },
];
---

<section class="trust" aria-label="Le cabinet en bref">
  <ul class="container trust__list reveal-children">
    {
      items.map(({ icon: Icon, title, text }) => (
        <li class="trust__item">
          <span class="trust__icon">
            <Icon size={22} aria-hidden="true" />
          </span>
          <span>
            <strong>{title}</strong>
            <span class="trust__text">{text}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust {
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .trust__list {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin-block: 0;
    list-style: none;
  }

  .trust__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    line-height: 1.35;
  }

  .trust__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    background: var(--color-sand);
    color: var(--color-accent-text);
  }

  strong {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
  }

  .trust__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Mobile : grille 2 × 2 compacte, icône au-dessus du texte */
  @media (max-width: 47.99rem) {
    .trust {
      padding-block: var(--space-4);
    }

    .trust__list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4) var(--space-3);
    }

    .trust__item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .trust__icon {
      width: 2.5rem;
      height: 2.5rem;
    }

    strong {
      font-size: var(--text-base);
    }

    .trust__text {
      font-size: var(--text-xs);
    }
  }
</style>
