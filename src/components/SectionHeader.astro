---
interface Props {
  /** id du <h2>, à référencer via aria-labelledby sur la section parente. */
  id: string;
  title: string;
  eyebrow?: string;
  lead?: string;
  align?: 'start' | 'center';
}

const { id, title, eyebrow, lead, align = 'start' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`, 'reveal']}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--container-text);
    margin-bottom: var(--space-5);
  }

  .section-header--center {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }
</style>
