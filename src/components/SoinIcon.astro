---
import { Baby, Dumbbell, HeartHandshake, PersonStanding, FaceSlightlySmiling } from '@lucide/astro';
import type { SoinIconKey } from '../lib/icons';

interface Props {
  name: SoinIconKey;
  size?: number;
}

const icons = {
  baby: Baby,
  pregnancy: HeartHandshake,
  sport: Dumbbell,
  adult: PersonStanding,
  jaw: FaceSlightlySmiling,
} satisfies Record<SoinIconKey, unknown>;

const { name, size = 24 } = Astro.props;
const Icon = icons[name];
---

<Icon size={size} stroke-width={1.6} aria-hidden="true" />
