---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBookingBar from '../components/MobileBookingBar.astro';
import { ui, type Lang } from '../lib/i18n';
import { breadcrumbSchema, siteGraph } from '../lib/schema';
import { link } from '../lib/paths';
import { token } from '../lib/tokens';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Entités JSON-LD propres à la page (FAQPage, Service…), ajoutées au graphe commun. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Fil d'Ariane hors accueil, ex. [{ name: 'Soins', path: '/soins' }] (JSON-LD BreadcrumbList). */
  breadcrumbs?: { name: string; path: string }[];
  lang?: Lang;
  /** Chemin de la même page dans l'autre langue (ex. "/en" depuis l'accueil). */
  alternate?: string;
}

const { title, description, noindex, schema, breadcrumbs, lang = 'fr', alternate } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(Astro.site!),
    ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs, Astro.site!)] : []),
    ...(schema ? [schema].flat() : []),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={token('color-primary')} />
    <link rel="icon" href={link('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <link rel="sitemap" href={link('/sitemap-index.xml')} />
    <Seo title={title} description={description} noindex={noindex} lang={lang} alternate={alternate} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{ui[lang].skipLink}</a>
    <Header lang={lang} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <MobileBookingBar label={ui[lang].bookShort} />
  </body>
</html>
